# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FoundaPay ERP — Production environment template
# Copy to .env on the server, then fill in real values.
# Do NOT commit the populated .env to source control.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NODE_ENV=production
PORT=5001

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foundapay_erp
DB_USER=foundapay_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── JWT ─────────────────────────────────────────────────────
# Generate via:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h

# ── Admin defaults (only used by seed) ──────────────────────
ADMIN_EMAIL=admin@foundapay.com
ADMIN_PASSWORD=CHANGE_THIS_THEN_CHANGE_AGAIN_VIA_UI

# ── Portal URLs ─────────────────────────────────────────────
PORTAL_URL=https://portal.foundapay.com

# ── Email — SendGrid recommended for production ─────────────
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASS=SENDGRID_API_KEY_HERE
MAIL_FROM=FoundaPay ERP <noreply@foundapay.com>

# ── Payment processors ──────────────────────────────────────
# WARNING: direct card-handling triggers PCI DSS SAQ-D scope.
# Strongly recommended: switch to hosted-fields integrations
# (Authorize.net Accept.js, NMI Collect.js) before production.

AUTHNET_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_SANDBOX=false

PAYMENTCLOUD_USERNAME=
PAYMENTCLOUD_PASSWORD=

NMI_SECURITY_KEY=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01
